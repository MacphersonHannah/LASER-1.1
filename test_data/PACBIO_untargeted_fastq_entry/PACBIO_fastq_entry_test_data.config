// nextflow.config - LASER PacBio cDNA for samples post lima AND post refine steps. Input is .fastq
// ------------------------------------------------------------------------------
// QUICK START:
//   Run: bash run_LASER.sh [chosen_name_of_run] this_config.config whilst inside the LASER-1.1 folder.
// ------------------------------------------------------------------------------

params {

  // ---------------------------------------------
  // PLATFORM
  // ---------------------------------------------
  platform = 'pacbio_fastqentry'

  // ---------------------------------------------
  // SPECIES
  // Both parameters are currently required by different modules.
  // ---------------------------------------------
  species     = 'human'   // read by ORFannotate

  // ---------------------------------------------
  // INPUT
  // One or more directories containing per-sample post-refine PacBio FLNC files.
  // All directories listed here are processed together in the same LASER run.
  //
  // NB: LASER can be run on a single sample, but theta cannot be calibrated
  // from one sample alone. In that case, use theta_mode = 'lift' to reuse an
  // appropriate calibrated theta. Where possible, running two or more samples
  // allows theta to be calibrated from the supplied data.
  // ---------------------------------------------
  library_dirs = [
      "${projectDir}/test_data/PACBIO_untargeted_fastq_entry"
  ]

  // BAM conversion template supplied with the cloned repository.
  // This uses a generic header and does not need to be sample-specific.
  pacbio_template_bam = "${projectDir}/test_data/pacbio_header_template.bam"

  // Read handling / phasing
  phase_indels             = true
  phase_min_qual           = 0
  include_unassigned_reads = false
  clair3_enable_phasing    = false   // false for PacBio; optional for ONT

  // ONT-only parameters retained here so switching platform does not require
  // re-adding them. They are ignored for pacbio_fastqentry.
  ont_fastq_files = ['']
  pychopper_kit      = ''
  pychopper_rescued  = false

  // ---------------------------------------------
  // REFERENCES
  // ---------------------------------------------
  genome      = '/path/to/GRCh38_noY_noMT.fa' // .fai must be alongside; chrY/chrMT removal is optional
  gencode_gtf = '/path/to/gencode.v47_noY_noMT.annotation.gtf'

  // SQANTI3 supplementary annotation files.
  // Human files: mouse equivalents are needed for mouse data.
  //   cage:        refTSS BED - mouse: refTSS_v3.3_mouse_coordinate.mm39.bed
  //   intropolis:  splice junction support - no direct mouse equivalent; use an empty
  //                file (touch empty.tsv) or omit if your SQANTI version supports --coverage ""
  //   polya_atlas: PolyA site atlas BED - mouse: atlas.clusters.2.0.GRCm39.96.mod.bed
  //   poly_motifs: polyA hexamer list - human list is appropriate for mouse
  // Where to obtain these files is described in the repo.
  cage        = '/path/to/refTSS_v3.3_human_coordinate.hg38.bed' // remove header from this file
  intropolis  = '/path/to/intropolis.v1.hg19_with_liftover_to_hg38.min_count_10.tsv'
  polya_atlas = '/path/to/atlas.clusters.2.0.GRCh38.96.mod.bed'
  poly_motifs = "${projectDir}/assets/human.polyA.list.txt"

  // ---------------------------------------------
  // TOOL PATHS
  // Created during setup. Locations can be changed, but version changes may cause crashes.
  // ---------------------------------------------
  sqanti_dir       = "${projectDir}/tools/SQANTI3v5.2.2"
  cupcake_path     = "${projectDir}/tools/cDNA_Cupcake"
  sqanti_chunks    = 10
  orf_script       = "${projectDir}/tools/ORFannotate/ORFannotate.py"
  coding_cutoff    = null   // ORFannotate only adds --coding-cutoff if this is set

  // ---------------------------------------------
  // VARIANT CALLING
  // DeepVariant is strongly recommended for PacBio.
  // ---------------------------------------------
  dv_container    = "${projectDir}/containers/deepvariant_1.9.0_sandbox"
  dv_model        = 'MASSEQ'   // PacBio Iso-Seq / MAS-Seq model
  dv_regions      = ''
  dv_minimap_opts = '-ax splice:hq -uf --secondary=no'

  hp_regions     = null
  variant_caller = 'deepvariant'
  clair3_model   = null
  

  // ---------------------------------------------
  // ALLELIC EFFECT TESTING (abTE / abTU)
  // ---------------------------------------------
  // theta_mode: 'calibrate_pooled' | 'calibrate_pooled_by_group' | 'fixed' | 'lift'
  //   calibrate_pooled : run permutation-FPR calibration once, pooled across
  //                      every sample in this run, and apply that one theta
  //                      to everyone.
  //   calibrate_pooled_by_group : same calibration, run once per named group
  //                      (e.g. brain/heart/other) instead of pooling every
  //                      sample in the run into one theta. Needs
  //                      theta_group_table (CSV: sample,group) below.
  //   fixed            : supply your own theta -- either theta_fixed
  //                      (one value for every sample) or theta_table
  //                      (CSV: sample,theta for per-sample values).
  //   lift             : reuse an already-calibrated reference theta
  //                      (brain_dlpfc / heart / all_encode) instead of
  //                      recalibrating on your own data. theta_lift_source
  //                      is the default for every sample; theta_lift_table
  //                      (CSV: sample,source) overrides it per sample.
  // More explanation available in LASER's README.

  theta_mode = 'calibrate_pooled'

  // Used only if theta_mode = 'calibrate_pooled_by_group'.
  // Maps every sample to a group, e.g.:
  //   sample,group
  //   brain_1,brain
  //   brain_2,brain
  //   heart_1,heart
  // Every sample in the run must appear in this table.
  theta_group_table = "${projectDir}/assets/theta_group_table_all_samples.csv"

  // Used only if theta_mode = 'fixed'
  theta_fixed = null
  theta_table = null   // optional CSV: sample,theta

  // Used only if theta_mode = 'lift'
  theta_reference_csv = "${projectDir}/assets/calibrated_thetas_reference.csv"
  theta_lift_source   = 'brain_dlpfc'
  theta_lift_table    = null   // optional CSV: sample,source

  // Used for calibrate_pooled / calibrate_pooled_by_group
  theta_calib_max_loci    = 2000
  theta_calib_n_null_ref  = 500
  theta_calib_n_test      = 50
  theta_calib_nominal_fpr = 0.05
  theta_calib_seed        = 456

  // Locus-level filtering
  min_transcripts_per_locus  = 2
  min_reads_per_transcript   = 1
  min_total_reads_per_locus  = 30
  min_phased_reads_per_locus = 30
  min_reads_per_haplotype    = 5
  max_unphased_prop          = 0.30

  // abTE (binomial) test
  abte_fdr_threshold        = 0.05
  abte_effect_guard         = true
  abte_major_frac_threshold = 0.55
  abte_fdr_scope            = 'sample'

  // abTU (permutation Dirichlet-Multinomial) test
  abtu_fdr_threshold = 0.05
  abtu_effect_guard  = false
  abtu_tvd_threshold = 0.20
  abtu_perm_b        = 1000
  dm_perm_seed       = 123

  // Consequence module
  conseq_perm_b        = 2000
  conseq_perm_seed     = 123
  conseq_fdr_threshold = 0.05

  conseq_dist_test = null
  conseq_run_label = null
}

// -----------------------------------------------------------------------------
// CONDA / MAMBA
// -----------------------------------------------------------------------------
profiles {
  conda {
    conda.enabled      = true
    conda.autoActivate = true
    conda.mamba        = true
    cacheDir = "${projectDir}/.conda_cache"
  }
}

// -----------------------------------------------------------------------------
// PROCESS RESOURCES
// Tune cpus/memory to your HPC node. The values below assume a large shared
// node (~250 cores, ~900 GB RAM). Reduce if running on smaller hardware.
// -----------------------------------------------------------------------------
process {
  cpus   = 16
  memory = '120 GB'
  time   = '100h'



  withName: 'RUN_DEEPVARIANT' {
    maxForks  = 7
    cpus      = 32
  }

  // Allelic effect testing processes are single-threaded R
  withName: 'PREPARE_LOCI_TABLES|VALIDATE_THETA_SAMPLE_COUNT|VALIDATE_THETA_GROUP_SAMPLE_COUNT|CALIBRATE_THETA_POOLED|CALIBRATE_THETA_POOLED_BY_GROUP|RESOLVE_FIXED_THETA|LIFT_THETA|RUN_ALLELIC_EFFECT_TEST|MERGE_RUN_MANIFEST' {
    cpus   = 1
    memory = '8 GB'
    time   = '12h'
  }
}

// -----------------------------------------------------------------------------
// EXECUTOR
// Adjust cpus/memory to match your node's actual resources.
// -----------------------------------------------------------------------------
executor {
  name      = 'local'
  cpus      = 250
  memory    = '900 GB'
  queueSize = 200
}

// -----------------------------------------------------------------------------
// SINGULARITY / APPTAINER
// Container runtime configuration. Nextflow retains the 'singularity'
// configuration name even when Apptainer is used on the system.
// -----------------------------------------------------------------------------
singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = "${projectDir}/containers/cache"
  runOptions = "--tmpdir ${projectDir}/containers/tmp"
}

env {
  SINGULARITY_CACHEDIR     = "${projectDir}/containers/cache"
  SINGULARITY_TMPDIR       = "${projectDir}/containers/tmp"
  NXF_SINGULARITY_CACHEDIR = "${projectDir}/containers/cache"
  TMPDIR                   = "${projectDir}/containers/tmp"
}
