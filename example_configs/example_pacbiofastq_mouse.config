// nextflow.config - LASER PacBio cDNA for samples post lima AND post refine steps. Mouse example
// ------------------------------------------------------------------------------
// QUICK START:
//   Run:  bash run_LASER.sh [chosen_name_of_run] this_config.config whilst inside the LASER-1.1 folder.
// ------------------------------------------------------------------------------

params {

  // ---------------------------------------------
  // PLATFORM  (preset for post-refine FLNC input)
  // ---------------------------------------------
  platform = 'pacbio_fastqentry'

  // ---------------------------------------------
  // INPUT
  // One or more directories containing per-sample FLNC files (.bam, .fastq.gz, .fq.gz, .fastq, or .fq).
  // Each file becomes one sample; filename (minus extension and trailing _flnc / .flnc) becomes the sample label.
  // If you were starting from subreads you would also need a primers.fa here, but not in this example as you're starting post CCS/lima/refine.
  // ---------------------------------------------
  library_dirs = ['EXAMPLE/data/test_mouse_encode1', 'EXAMPLE/data/test_mouse_encode2']   // Can be any number of folders, they will all be run together. In this example all samples are from the same tissue.

  // BAM conversion template. Provided within cloned github repo. Generic header, no need to swap to a sample-specific one.
  pacbio_template_bam = "${projectDir}/test_data/pacbio_header_template.bam"


  // ---------------------------------------------
  // REFERENCES
  // ---------------------------------------------
  genome      = 'EXAMPLE/references/mouse/GRCm39.primary_assembly.genome.fa'     // Must have .fai alongside but no need to link it. Can optionally remove chrMT and chrY for speed (see README)
  gencode_gtf = 'EXAMPLE/references/mouse/gencode.vM36.annotation.gtf'   // e.g.GENCODE GTF


  // SQANTI3 supplementary annotation files.
  // Human files : mouse equivalents needed for mouse data.
  //   cage:        refTSS BED    - mouse: refTSS_v3.3_mouse_coordinate.mm39.bed
  //   intropolis:  splice junction support - no direct mouse equivalent; use an empty
  //                file (touch empty.tsv) or omit if your SQANTI version supports --coverage ""
  //   polya_atlas: PolyA site atlas BED  - mouse: atlas.clusters.2.0.GRCm39.96.mod.bed
  //                (or use human file; polyA hexamers are conserved)
  //   poly_motifs: polyA hexamer list    - human list is appropriate for mouse
  cage        = 'EXAMPLE/references/mouse/refTSS_v4.1_mouse_coordinate.mm39.noheader.bed'    // Remove the header from this file
  intropolis  = '/path/to/intropolis_junctions.tsv'     // (No direct mouse equivalent so run as a placeholder)
  polya_atlas = 'EXAMPLE/references/mouse/atlas.clusters.2.0.GRCm39.96.mod.bed'      
  poly_motifs = "${projectDir}/assets/human.polyA.list.txt"        // human list is fine for mouse


  // ---------------------------------------------
  // TOOL PATHS  (Created during setup. Location can be changed, but version changes may cause crashes.)
  // ---------------------------------------------
  sqanti_dir       = "${projectDir}/tools/SQANTI3v5.2.2"
  cupcake_path     = "${projectDir}/tools/cDNA_Cupcake"
  sqanti_chunks    = 10
  orf_script       = "${projectDir}/tools/ORFannotate/ORFannotate.py"


  // ---------------------------------------------
  // SPECIES
  // ---------------------------------------------
  // Used by ORFANNOTATE (CPAT coding-potential model) and by SQANTI_QC (to
  // decide whether to pass --coverage from the intropolis junctions file).
  // Supported values: 'human'  'mouse'  (check ORFannotate docs for full list).
  species = 'mouse'   // Set to'human' for human data
  coding_cutoff = null


  // ---------------------------------------------
  // VARIANT CALLING
  // DeepVariant is strongly recommended for PacBio (much higher phasing rate than Clair3-RNA on Iso-Seq data).
  // ---------------------------------------------
  dv_container = "${projectDir}/containers/deepvariant_1.9.0_sandbox" // created during setup
  dv_model     = 'MASSEQ'   // correct for PacBio Iso-Seq / MAS-Seq regardless of species or platform (Revio or RSII)
  variant_caller = 'deepvariant' // change this if you want to use Clair3 (not recommended)


  // ---------------------------------------------
  // PHASING
  // ---------------------------------------------
  phase_indels            = true // recommended
  phase_min_qual          = 0 // recommended - increasing the required quality may skew the counts from each allele


  // ---------------------------------------------
  // ALLELIC EFFECT TESTING (abTE / abTU)
  // ---------------------------------------------
  // theta_mode: 'calibrate_pooled' | 'calibrate_pooled_by_group' | 'fixed' | 'lift'
  //   calibrate_pooled : run permutation-FPR calibration once, pooled across
  //                      every sample in this run, and apply that one theta
  //                      to everyone.
  //   calibrate_pooled_by_group : same calibration, run once per named group
  //                      (e.g. brain/heart/other) instead of pooling every
  //                      sample in the run into one theta. Needs
  //                      theta_group_table (CSV: sample,group).
  //   fixed            : supply your own theta -- either theta_fixed
  //                      (one value for every sample) or theta_table
  //                      (CSV: sample,theta for per-sample values).
  //   lift             : reuse an already-calibrated reference theta
  //                      (brain_dlpfc / heart / all_encode) instead of
  //                      recalibrating on your own data. theta_lift_source
  //                      is the default for every sample; theta_lift_table
  //                      (CSV: sample,source) overrides it per sample --
  //                      e.g. brain_dlpfc for your brain samples, heart for
  //                      your heart samples, in the same run.
  // More explanation available in LASER's README.

  theta_mode = 'calibrate_pooled'   // Recommended if all samples are the same tissue, see above for other options

  // used only if theta_mode = 'calibrate_pooled_by_group' -- maps every
  // sample to its own group name, e.g.:
  //   sample,group
  //   brain_1,brain
  //   brain_2,brain
  //   heart_1,heart
  // every sample in the run must appear in this table or
  // VALIDATE_THETA_GROUP_SAMPLE_COUNT fails fast before calibration runs.
  // not needed in this single-tissue example, left commented as reference:
  // theta_group_table = 'EXAMPLE/assets/theta_group_table.csv'

  // used only if theta_mode = 'fixed'
  theta_fixed = null
  theta_table = null   // path to CSV: sample,theta eg /assets/theta_group_table_all_samples.csv

  // used only if theta_mode = 'lift'
  theta_reference_csv = "${projectDir}/assets/calibrated_thetas_reference.csv"
  theta_lift_source   = 'brain_dlpfc'   // default source applied to every sample. Name refers to an option in the csv mentioned above.
  theta_lift_table    = null           // optional path to CSV: sample,source

  // used if theta_mode = 'calibrate_pooled' or 'calibrate_pooled_by_group'
  // (same calibration parameters, just run once overall vs once per group)
  theta_calib_max_loci    = 2000
  theta_calib_n_null_ref  = 500
  theta_calib_n_test      = 50
  theta_calib_nominal_fpr = 0.05
  theta_calib_seed        = 456

  // locus-level filtering (applied at the read-count-summary stage, downstream
  // of any earlier variant-level filtering elsewhere in the pipeline)
  min_transcripts_per_locus  = 2
  min_reads_per_transcript   = 1
  min_total_reads_per_locus  = 30
  min_phased_reads_per_locus = 30
  min_reads_per_haplotype    = 5
  max_unphased_prop          = 0.30

  // abTE (binomial) test
  abte_fdr_threshold        = 0.05
  abte_effect_guard         = true
  abte_major_frac_threshold = 0.55
  abte_fdr_scope            = 'sample'   // 'sample' only supported currently - see README

  // abTU (permutation Dirichlet-Multinomial) test
  abtu_fdr_threshold = 0.05
  abtu_effect_guard  = false
  abtu_tvd_threshold = 0.20
  abtu_perm_b        = 1000
  dm_perm_seed       = 123

  //  consequence module 
  conseq_perm_b         = 2000
  conseq_perm_seed      = 123
  conseq_fdr_threshold  = 0.05

  conseq_dist_test = null
  conseq_run_label = null

}


// ---------------------------------------------
// CONDA / MAMBA
// ---------------------------------------------
profiles {
  conda {
    conda.enabled      = true
    conda.autoActivate = true
    conda.mamba        = true
    cacheDir = "${projectDir}/.conda_cache"
  }
}


// ---------------------------------------------
// PROCESS RESOURCES
// Tune cpus/memory to your HPC node.  The values below assume a large shared
// node (~250 cores, ~900 GB RAM).  Reduce if running on smaller hardware. 
// ---------------------------------------------
process {
  cpus   = 16
  memory = '120 GB'
  time   = '100h'


  withName: 'RUN_DEEPVARIANT' {
    maxForks  = 7
    cpus      = 32
  }

  withName: 'PREPARE_LOCI_TABLES|VALIDATE_THETA_SAMPLE_COUNT|VALIDATE_THETA_GROUP_SAMPLE_COUNT|CALIBRATE_THETA_POOLED|CALIBRATE_THETA_POOLED_BY_GROUP|RESOLVE_FIXED_THETA|LIFT_THETA|RUN_ALLELIC_EFFECT_TEST|MERGE_RUN_MANIFEST' {
    cpus   = 1
    memory = '8 GB'
    time   = '12h'
  }
}


// ---------------------------------------------
// EXECUTOR
// Adjust cpus/memory to match your node's actual resources.
// ---------------------------------------------
executor {
  name      = 'local'
  cpus      = 250       // total cores you could allocate on your node
  memory    = '900 GB'  // total RAM  you could allocate on your node
  queueSize = 200
}


// ---------------------------------------------
// SINGULARITY
// ---------------------------------------------

singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = "${projectDir}/containers/cache"
  runOptions = "--tmpdir ${projectDir}/containers/tmp"
}

env {
  SINGULARITY_CACHEDIR     = "${projectDir}/containers/cache"
  SINGULARITY_TMPDIR       = "${projectDir}/containers/tmp"
  NXF_SINGULARITY_CACHEDIR = "${projectDir}/containers/cache"
  TMPDIR                   = "${projectDir}/containers/tmp"
}