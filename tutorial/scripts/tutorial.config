// tutorial.config -- LASER tutorial
// 8 mouse ENCODE PacBio FLNC samples (fastq.gz), subset to chr17, mm10 / GENCODE vM10.
// ------------------------------------------------------------------------------
// Lives in LASER-1.1/tutorial/scripts/. All paths are relative to the LASER-1.1
// folder (${projectDir}), so nothing needs editing after cloning.
// Submit from LASER-1.1/tutorial with:   sbatch scripts/run_tutorial.sh
// Sized for ONE SLURM job of 16 CPUs / ~54 GB. Executor limits below must never
// promise more than that job holds.
// ------------------------------------------------------------------------------

def TUT = "${projectDir}/tutorial"
def TREF = "${TUT}/data/reference"
def containerBase = new File("${projectDir}/containers").canonicalPath
params {

  // ─────────────────────────────────────────────
  // PLATFORM
  // ─────────────────────────────────────────────
  platform = 'pacbio_fastqentry'

  // ─────────────────────────────────────────────
  // INPUT -- every FASTQ in this folder becomes one sample (8 here)
  // ─────────────────────────────────────────────
  library_dirs        = ["${TUT}/data/fastq"]
  pacbio_template_bam = "${projectDir}/test_data/pacbio_header_template.bam"

  start_from_demux         = true
  include_unassigned_reads = false

  // ─────────────────────────────────────────────
  // REFERENCES -- chr17 only, all inside tutorial/data/reference
  // ─────────────────────────────────────────────
  genome      = "${TREF}/GRCm38_chr17.fa"                   // .fai alongside
  gencode_gtf = "${TREF}/gencode.vM10_chr17.annotation.gtf"

  // SQANTI3 extras -- mm10/GRCm38 versions, chr17 only, chromosome named "chr17"
  // to match the genome and GTF (see the tutorial README for how they were made).
  cage        = "${TREF}/refTSS_v4.1_mouse_chr17.mm10.bed"     // refTSS v4.1 mouse, lifted to mm10, no header
  intropolis  = ''                                             // no mouse equivalent; SQANTI skips --coverage for mouse
  polya_atlas = "${TREF}/polyA_atlas_2.0_GRCm38_chr17.bed"     // PolyASite atlas 2.0, GRCm38 (= mm10)
  poly_motifs = "${TREF}/polyA_motifs.txt"                     // polyA hexamer list (human list is fine for mouse)

  // ─────────────────────────────────────────────
  // TOOL PATHS (created during LASER setup)
  // ─────────────────────────────────────────────
  sqanti_dir    = "${projectDir}/tools/SQANTI3v5.2.2"
  cupcake_path  = "${projectDir}/tools/cDNA_Cupcake"
  sqanti_chunks = 4
  orf_script    = "${projectDir}/tools/ORFannotate/ORFannotate.py"
  coding_cutoff = null

  // ─────────────────────────────────────────────
  // SPECIES
  // ─────────────────────────────────────────────
  species = 'mouse'

  // ─────────────────────────────────────────────
  // VARIANT CALLING + PHASING
  // ─────────────────────────────────────────────
  dv_container   = "${projectDir}/containers/deepvariant_1.9.0_sandbox"
  dv_model       = 'MASSEQ'
  variant_caller = 'deepvariant'

  phase_indels   = true
  phase_min_qual = 0

  // ─────────────────────────────────────────────
  // LOCUS FILTERING (defaults)
  // ─────────────────────────────────────────────
  min_transcripts_per_locus  = 2
  min_reads_per_transcript   = 1
  min_total_reads_per_locus  = 30
  min_phased_reads_per_locus = 30
  min_reads_per_haplotype    = 5
  max_unphased_prop          = 0.30

  // ─────────────────────────────────────────────
  // THETA
  // calibrate_pooled mirrors a real run. If the chr17 subset leaves too few
  // loci for calibration, switch to theta_mode = 'lift' (uses theta_lift_source).
  // ─────────────────────────────────────────────
  theta_mode = 'calibrate_pooled'

  theta_calib_max_loci    = 2000
  theta_calib_n_null_ref  = 500
  theta_calib_n_test      = 50
  theta_calib_nominal_fpr = 0.05
  theta_calib_seed        = 456

  theta_group_table   = null
  theta_fixed         = null
  theta_table         = null
  theta_reference_csv = "${projectDir}/assets/calibrated_thetas_reference.csv"
  theta_lift_source   = 'all_encode'
  theta_lift_table    = null

  // ─────────────────────────────────────────────
  // abTE / abTU (defaults)
  // ─────────────────────────────────────────────
  abte_fdr_threshold        = 0.05
  abte_effect_guard         = true
  abte_major_frac_threshold = 0.55
  abte_fdr_scope            = 'sample'
  abtu_fdr_threshold        = 0.05
  abtu_effect_guard         = false
  abtu_tvd_threshold        = 0.20
  abtu_perm_b               = 1000
  dm_perm_seed              = 123

  // ─────────────────────────────────────────────
  // CONSEQUENCE MODULE
  // ─────────────────────────────────────────────
  conseq_perm_b        = 2000
  conseq_perm_seed     = 123
  conseq_fdr_threshold = 0.05
}


// ─────────────────────────────────────────────────────────────────────────────
// CONDA
// ─────────────────────────────────────────────────────────────────────────────
profiles {
  conda {
    conda.enabled      = true
    conda.autoActivate = true
    conda.mamba        = true
    cacheDir = "${projectDir}/.conda_cache"
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// PROCESS RESOURCES -- small data, one 16-CPU job
// ─────────────────────────────────────────────────────────────────────────────
process {
  cpus   = 4
  memory = '12 GB'
  time   = '6h'
  publishDir = [ mode: 'copy' ]

  withName: 'CLUSTER' {
    cpus   = 8
    memory = '24 GB'
  }
  withName: 'SQANTI_QC|ORFANNOTATE' {
    cpus   = 8
    memory = '24 GB'
  }
  withName: 'RUN_DEEPVARIANT' {
    container = "${projectDir}/containers/deepvariant_1.9.0_sandbox"
    maxForks  = 2
    cpus      = 8
    memory    = '20 GB'
  }
  withName: 'PREPARE_LOCI_TABLES|CALIBRATE_THETA_POOLED|CALIBRATE_THETA_POOLED_BY_GROUP|RESOLVE_FIXED_THETA|LIFT_THETA|RUN_ALLELIC_EFFECT_TEST|MERGE_RUN_MANIFEST' {
    cpus   = 1
    memory = '4 GB'
    time   = '2h'
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// EXECUTOR -- must fit inside the SLURM request in run_tutorial.sh:
//   --cpus-per-task=16  --mem=54000M   (icelake gives ~3380 MB per CPU, so
//   16 CPUs = ~54 GB; asking for more memory just gets you charged for more CPUs)
// 48 GB here leaves ~6 GB for Nextflow itself and the OS.
// Largest single task (CLUSTER / SQANTI_QC / ORFANNOTATE) = 8 CPUs, 24 GB;
// two DeepVariant jobs at once = 16 CPUs, 40 GB. Both fit.
// If you change the SLURM request, change these two numbers to match.
// ─────────────────────────────────────────────────────────────────────────────
executor {
  name      = 'local'
  cpus      = 16
  memory    = '48 GB'
  queueSize = 4
}


// ─────────────────────────────────────────────────────────────────────────────
// SINGULARITY
// ─────────────────────────────────────────────────────────────────────────────
singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = "${containerBase}/cache"
  runOptions = "--tmpdir ${containerBase}/tmp"
}

env {
  SINGULARITY_CACHEDIR     = "${containerBase}/cache"
  SINGULARITY_TMPDIR       = "${containerBase}/tmp"
  NXF_SINGULARITY_CACHEDIR = "${containerBase}/cache"
  TMPDIR                   = "${containerBase}/tmp"
}
